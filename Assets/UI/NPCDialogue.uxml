<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Background" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/Ruby/UI/UIDialogueBox.png?fileID=21300000&amp;guid=c4592e9bd029fcc45843314f2192f59e&amp;type=3#UIDialogueBox&quot;); background-color: rgba(0, 0, 0, 0); width: 100%; height: 100%;">
        <ui:Label text="Hola! Detrás de esta puerta hay dos grandes enemigos que tendrás que derrotar, cada uno mas poderoso que el anterior. Ten cuidado con sus ataques y sus súbditos. Tendrás que acabar con ambos sin morir una sola vez para conseguir superar el reto.&#10;&#10;CONTROLES:&#10;- Mover al personaje: W A S D&#10;- Disparar: Click izquierdo del raton hacia donde este clicando&#10;- Dash o Esquivo: Espacio&#10;&#10;TIPS:&#10;- El dash tiene un cooldown de 1 segundo&#10;- Los subditos derrotados tienen cierta probabilidad de soltar consumibles curativos&#10;- No se quede quieto ningún segundo" style="width: 100%; height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 35px; padding-right: 35px; padding-bottom: 35px; padding-left: 35px; font-size: 25px; color: rgb(255, 255, 255); white-space: normal; -unity-font-style: bold;"/>
    </ui:VisualElement>
</ui:UXML>
